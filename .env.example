# ==============================================================================
# APEX ACADEMY MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env: cp .env.example .env
# In development (NODE_ENV=development), real API keys are optional.
# Mock adapters will log OTPs directly to terminal.

# --- SERVER CONFIGURATION ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- EDGE REVERSE PROXY & HOST FORWARDING ---
# Shared secret required between Cloudflare Pages Edge Function and backend in production (min 16 chars).
EDGE_PROXY_SECRET=your-secure-edge-proxy-secret-min-16-chars
# Upstream backend URL configured in Cloudflare Pages environment variables (functions/api/[[catchall]].ts)
BACKEND_API_URL=https://api.kampus.pk

# --- SUPABASE AUTH & ASYMMETRIC VERIFICATION ---
# Supabase project URL and API keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend-only secret service role key (Never expose to frontend, never use for ordinary business queries)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Asymmetric JWKS and token verification claims
SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Exact production redirect callback (no wildcard allowlists)
AUTH_REDIRECT_URL=https://app.kampus.pk/auth/callback

# --- FRONTEND CLIENT VARIABLES (Vite builds) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Exact browser origins, comma-separated. Tenant HTTPS subdomains of BASE_DOMAIN are also allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.kampus.pk

# --- DATABASE / POSTGRESQL ---
# Direct PostgreSQL connection string (for migrations and backend connection pool)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# PEM CA certificate for hosted PostgreSQL when the system trust store is insufficient.
DATABASE_SSL_CA=

# --- DOMAIN & CLOUDFLARE CONFIGURATION ---
# Platform host is app.kampus.pk. Tenant academies are {slug}.kampus.pk.
# Do not point the zone apex (kampus.pk) at this app — it is reserved for another project.
BASE_DOMAIN=kampus.pk
CLOUDFLARE_PAGES_TARGET=kampus-academy.pages.dev
CLOUDFLARE_PAGES_PROJECT=kampus-academy
# Token needs Zone:Zone Read, Zone:DNS Edit, Account:Cloudflare Pages Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- BREVO TRANSACTIONAL EMAIL NOTIFICATIONS ---
# Used for invitations and administrative alert emails
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@kampus.pk
BREVO_SENDER_NAME="Kampus"
# Explicitly opt into fixture tenants in local development. Must reject production.
ALLOW_DEMO_SEED=false

# --- FIREBASE CLOUD MESSAGING (PHASE 3 & 7) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
