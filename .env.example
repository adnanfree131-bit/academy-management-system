# ==============================================================================
# APEX ACADEMY MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env: cp .env.example .env
# In development (NODE_ENV=development), real API keys are optional.
# Mock adapters will log OTPs directly to terminal.

# --- SERVER CONFIGURATION ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- SECURITY & JWT ---
# Minimum 32-character string for signing session tokens
JWT_SECRET=change-this-to-a-secure-random-32-char-string-in-production
JWT_EXPIRES_IN=7d

# --- DATABASE / SUPABASE (PHASE 1) ---
# Direct PostgreSQL connection string (for migrations and backend connection pool)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# Supabase API credentials (optional in dev if using local DB/pglite)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- BREVO EMAIL OTP (PHASE 1) ---
# If left empty in dev, OTP will be output to backend terminal console
BREVO_API_KEY=
BREVO_SENDER_EMAIL=admissions@apexacademy.edu.pk
BREVO_SENDER_NAME="Apex Academy ERP"
# Set a static OTP bypass for automated testing (leave empty in production)
DEV_STATIC_OTP=123456

# --- FIREBASE CLOUD MESSAGING (PHASE 3 & 7) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
